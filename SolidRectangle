import java.util.Scanner;

class GFG {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        int n = sc.nextInt();
        int m = sc.nextInt();

       printSolidRectangle(n, m);
       
       sc.close();
    }  
       public static void printSolidRectangle(int n, int m){
         
        for(int i = 0; i < n; i++){
            
            for(int j = 0; j < m; j++){
                
                System.out.println("* ");
            }  
                System.out.println();
        }
    }
}
