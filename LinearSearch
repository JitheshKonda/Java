public class LinearSearch {

    public static void main(String[] args) {

        int numbers[] = {10, 20, 30, 40, 50, 60};
        int search = 40;

        boolean found = false;

        for (int i = 0; i < numbers.length; i++) {

            if (numbers[i] == search) {

                System.out.println("Element Found at Index : " + i);
                found = true;
                break;
            }
        }

        if (!found) {
            System.out.println("Element Not Found");
        }
    }
}
